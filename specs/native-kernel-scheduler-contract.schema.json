        "saved_control_flow_state": {"const": ["RSP", "RIP", "RFLAGS"]},
        "interrupts_disabled": {"const": true},
        "same_cr3_required": {"const": true},
        "fs_gs_unchanged_required": {"const": true},
        "xstate_unused": {"const": true},
