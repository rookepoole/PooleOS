    "claims": {"type": "object", "minProperties": 20, "additionalProperties": {"type": "boolean"}},
    "non_claims": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
    "official_references": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
