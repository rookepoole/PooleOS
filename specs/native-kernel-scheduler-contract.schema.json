      "properties": {
        "cpu_capacity": {"const": 4},
        "task_capacity": {"const": 8},
        "run_queue_count": {"const": 4},
        "run_queue_capacity": {"const": 8},
        "minimum_priority": {"const": 1},
        "maximum_priority": {"const": 31},
        "maximum_equal_priority_bypass": {"const": 7},
