{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pooleos.local/schemas/native-kernel-errata-policy-readiness.schema.json",
  "title": "PooleOS PKERR1 readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status_date",
    "status",
    "contract_id",
    "selected_move_id",
    "production_ready",
    "production_promotion_allowed",
    "n7_exit_gate_satisfied",
    "phase_status",
    "inputs",
    "build_qualification",
    "source_audit",
    "windows_registry_observation",
    "current_policy_decision",
    "synthetic_policy_decision",
    "cross_language_vectors",
    "negative_controls",
    "claims",
    "summary",
    "open_items",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_kind": {"const": "pooleos_native_kernel_errata_policy_readiness"},
    "status_date": {"type": "string", "format": "date"},
    "status": {"const": "pass_policy_denies_current_target"},
    "contract_id": {"const": "PKERR1"},
    "selected_move_id": {"const": "N7-ERRATA-POLICY-001"},
    "production_ready": {"type": "boolean", "const": false},
    "production_promotion_allowed": {"type": "boolean", "const": false},
    "n7_exit_gate_satisfied": {"type": "boolean", "const": false},
    "phase_status": {"type": "object"},
    "inputs": {"type": "object"},
    "build_qualification": {"type": "object", "required": ["status", "rustc", "host_tests_passed", "host_tests_total", "rustfmt_packages", "clippy_targets", "no_std_targets"]},
    "source_audit": {"type": "object", "required": ["status", "forbidden_tokens", "forbidden_hits", "privileged_reads", "cpu_or_firmware_writes"]},
    "windows_registry_observation": {
      "type": "object",
      "required": ["status", "read_only", "record_count", "unique_revision_count", "normalized_revision", "identifier", "raw_registers_read", "msr_reads", "privileged_reads", "driver_loaded", "writes", "records"],
      "properties": {"records": {"type": "array", "minItems": 16, "maxItems": 16, "items": {
        "type": "object", "required": ["processor", "identifier", "revision_bytes_little_endian", "normalized_revision"]
      }}}
    },
    "current_policy_decision": {"type": "object", "required": ["decision", "failure_mask", "failure_codes", "policy_satisfied", "authority_grants", "actions_authorized", "state_writes"]},
    "synthetic_policy_decision": {"type": "object", "required": ["decision", "failure_mask", "failure_codes", "policy_satisfied", "authority_grants", "actions_authorized", "state_writes", "is_hardware_or_trust_evidence"]},
    "cross_language_vectors": {"type": "object", "required": ["status", "case_count", "mismatch_count", "satisfied_case_count", "failure_bit_coverage", "outcome_sha256"]},
    "negative_controls": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"type": "object", "required": ["id", "status", "expected"]}},
    "claims": {"type": "object"},
    "summary": {"type": "object"},
    "open_items": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}}
  }
}
