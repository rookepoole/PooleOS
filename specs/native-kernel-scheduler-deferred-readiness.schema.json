{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pooleos.invalid/schemas/native-kernel-scheduler-deferred-readiness.schema.json",
  "title": "PooleOS PKSCHED3 Readiness",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status_date",
    "status",
    "contract_id",
    "selected_move_id",
    "production_ready",
    "production_promotion_allowed",
    "n12_exit_gate_satisfied",
    "phase_status",
    "inputs",
    "build",
    "media",
    "execution",
    "observation",
    "negative_controls",
    "claims",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_kind": {"const": "pooleos_native_kernel_scheduler_deferred_readiness"},
    "status_date": {"type": "string", "format": "date"},
    "status": {"type": "string", "minLength": 1},
    "contract_id": {"const": "PKSCHED3"},
    "selected_move_id": {"const": "N12-SCHED-DEFERRED-001"},
    "production_ready": {"const": false},
    "production_promotion_allowed": {"const": false},
    "n12_exit_gate_satisfied": {"const": false},
    "phase_status": {"type": "object"},
    "inputs": {"type": "object"},
    "build": {
      "type": "object",
      "required": ["kernel_entry", "host_probe", "native_control_probe", "audit_controls", "source_audit", "linked_switch_audit"],
      "properties": {
        "kernel_entry": {"type": "object"},
        "host_probe": {"type": "object"},
        "native_control_probe": {"type": "object"},
        "audit_controls": {"type": "object"},
        "source_audit": {"type": "object"},
        "linked_switch_audit": {"type": "object"}
      }
    },
    "media": {"type": "object"},
    "execution": {"type": "object"},
    "observation": {"type": "object"},
    "negative_controls": {
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {
        "type": "object", "required": ["id", "status", "expected", "case_count"],
        "properties": {
          "id": {"type": "string"}, "status": {"const": "pass"},
          "expected": {"enum": ["rejected", "boundary_verified"]},
          "case_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "claims": {"type": "object"},
    "nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
