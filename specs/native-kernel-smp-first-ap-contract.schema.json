{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pooleos.local/specs/native-kernel-smp-first-ap-contract.schema.json",
  "title": "PooleOS PKSMP1 contract",
  "type": "object",
