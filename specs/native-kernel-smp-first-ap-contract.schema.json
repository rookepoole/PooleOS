    "profile": {"type": "object", "required": ["feature", "selector", "virtual_cpu_count", "bsp_count", "application_processor_count", "emulator_only"], "properties": {"feature": {"const": "development-smp-first-ap"}, "selector": {"const": 12}, "virtual_cpu_count": {"const": 2}, "bsp_count": {"const": 1}, "application_processor_count": {"const": 1}, "emulator_only": {"const": true}}},
    "topology": {"type": "object"},
    "resource_geometry": {"type": "object"},
    "startup": {"type": "object"},
    "mailbox": {"type": "object"},
    "shutdown_and_cleanup": {"type": "object"},
