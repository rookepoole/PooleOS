    "production_ready": {"const": false},
    "production_promotion_allowed": {"const": false},
    "phase_mapping": {"const": ["N8.1", "N8.2", "N8.3", "N8.5", "N9.2", "N9.3", "N9.4", "N9.5"]},
    "source_requirement_ids": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "profile": {
      "type": "object",
      "required": ["feature", "selector", "cpu_model", "acceleration", "virtual_cpu_count", "application_processor_count", "emulator_only"],
      "properties": {
        "feature": {"const": "development-smp-ipi"},
        "selector": {"const": 14},
        "cpu_model": {"const": "SandyBridge,-avx"},
        "acceleration": {"const": "tcg_multi_thread"},
        "virtual_cpu_count": {"const": 2},
        "application_processor_count": {"const": 1},
        "emulator_only": {"const": true}
      }
    },
    "topology": {
      "type": "object",
      "required": ["processor_count", "enabled_processor_count", "bsp_apic_id", "target_apic_id", "x2apic_allowed"],
      "properties": {
        "processor_count": {"const": 2},
        "enabled_processor_count": {"const": 2},
        "bsp_apic_id": {"const": 0},
        "target_apic_id": {"const": 1},
        "x2apic_allowed": {"const": false}
      }
    },
    "resource_geometry": {
      "type": "object",
      "required": ["page_count", "guard_page_count", "mapped_page_count", "apic_page_table"],
      "properties": {
        "page_count": {"const": 32},
        "guard_page_count": {"const": 14},
        "mapped_page_count": {"const": 13},
        "apic_page_table": {
          "type": "object",
          "required": ["page_offset", "pdpt_index", "page_directory_index", "page_table_index", "post_execution_accessed_dirty_bits_required"],
          "properties": {
            "page_offset": {"const": 31},
            "pdpt_index": {"const": 3},
            "page_directory_index": {"const": 503},
            "page_table_index": {"const": 0},
            "post_execution_accessed_dirty_bits_required": {"const": true}
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "required": ["capability_profile", "operation_classes", "live_accepted_deliveries", "live_denied_deliveries", "live_delivery_count", "live_eoi_count", "offline_target_timeout_count"],
      "properties": {
        "capability_profile": {"const": "development-only fixed token"},
        "operation_classes": {"type": "array", "minItems": 6, "maxItems": 6},
        "live_accepted_deliveries": {"const": 6},
        "live_denied_deliveries": {"const": 4},
        "live_delivery_count": {"const": 10},
        "live_eoi_count": {"const": 10},
        "offline_target_timeout_count": {"const": 1}
      }
    },
    "shootdown": {
      "type": "object",
      "required": ["probe_virtual", "retired_generation", "active_generation", "target_cpu_mask", "ack_cpu_mask", "remote_invlpg_count", "premature_reclaim_rejected", "reclaim_requires_exact_ack", "retired_frame_reuse_before_ack", "scope"],
      "properties": {
        "probe_virtual": {"const": "0x00000000001FF000"},
        "retired_generation": {"const": 1},
        "active_generation": {"const": 2},
        "target_cpu_mask": {"const": "0x0000000000000002"},
        "ack_cpu_mask": {"const": "0x0000000000000002"},
        "remote_invlpg_count": {"const": 1},
        "premature_reclaim_rejected": {"const": true},
        "reclaim_requires_exact_ack": {"const": true},
        "retired_frame_reuse_before_ack": {"const": false},
        "scope": {"type": "string"}
      }
    },
    "shutdown_and_cleanup": {
      "type": "object",
      "required": ["final_init_park_required_before_release", "capability_revoked", "resource_pages_released", "verified_bytes"],
      "properties": {
        "final_init_park_required_before_release": {"const": true},
        "capability_revoked": {"const": true},
        "resource_pages_released": {"const": 34},
        "verified_bytes": {"const": 131072}
