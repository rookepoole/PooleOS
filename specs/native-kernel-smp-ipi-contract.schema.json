    "required_negative_controls": {"type": "array", "minItems": 25, "maxItems": 25, "uniqueItems": true, "items": {"type": "string"}},
    "claims": {
      "type": "object",
      "required": ["flag_n8_smp_ipi_001_closed", "flag_n9_smp_shootdown_001_closed", "six_allowlisted_operation_classes_acknowledged", "one_page_remote_tlb_shootdown_implemented", "one_generation_retirement_implemented", "general_tlb_shootdown_implemented", "arbitrary_remote_callback_implemented", "scheduler_implemented", "n8_exit_gate_satisfied", "n9_exit_gate_satisfied", "production_ready"],
      "properties": {
        "flag_n8_smp_ipi_001_closed": {"const": true},
        "flag_n9_smp_shootdown_001_closed": {"const": true},
        "six_allowlisted_operation_classes_acknowledged": {"const": true},
        "one_page_remote_tlb_shootdown_implemented": {"const": true},
        "one_generation_retirement_implemented": {"const": true},
        "general_tlb_shootdown_implemented": {"const": false},
        "arbitrary_remote_callback_implemented": {"const": false},
        "scheduler_implemented": {"const": false},
        "n8_exit_gate_satisfied": {"const": false},
        "n9_exit_gate_satisfied": {"const": false},
        "production_ready": {"const": false}
      }
    },
    "non_claims": {"type": "array", "minItems": 9, "items": {"type": "string"}},
    "official_references": {"type": "array", "minItems": 3, "items": {"type": "string", "format": "uri"}}
  }
}
