  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_kind": {"const": "pooleos_native_kernel_smp_ipi_contract"},
    "contract_id": {"const": "PKSMP4"},
    "selected_move_id": {"const": "N9-SMP-SHOOTDOWN-001"},
    "status_date": {"const": "2026-07-29"},
