    },
    "qualification": {
      "type": "object",
      "required": ["qemu_run_count", "negative_control_count", "hostile_case_count"],
      "properties": {
        "qemu_run_count": {"const": 2},
        "negative_control_count": {"const": 25},
        "hostile_case_count": {"const": 169}
      }
