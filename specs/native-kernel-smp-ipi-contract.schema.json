{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pooleos.local/specs/native-kernel-smp-ipi-contract.schema.json",
  "title": "PooleOS PKSMP4 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "contract_id",
    "selected_move_id",
    "status_date",
    "status",
    "production_ready",
    "production_promotion_allowed",
    "phase_mapping",
    "source_requirement_ids",
    "profile",
    "topology",
    "resource_geometry",
    "transport",
    "shootdown",
    "shutdown_and_cleanup",
    "qualification",
    "required_negative_controls",
    "claims",
    "non_claims",
    "official_references"
