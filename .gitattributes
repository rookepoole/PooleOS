* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
tools/bootstrap_native_models.ps1 text eol=lf
tools/bootstrap_native_toolchain.ps1 text eol=lf

*.efi binary
*.elf binary
*.bin binary
*.img binary
*.iso binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary
*.zip binary

# Preserve checksum-verified upstream Cargo sources byte-for-byte.
native/vendor/** -whitespace

# Preserve the imported typography notice and exact firmware texture bytes.
demos/native_iso/boot/assets/FONT-LICENSE.txt -whitespace
demos/native_iso/boot/assets/*.alpha4 binary
demos/native_iso/boot/assets/*.index8 binary
demos/native_iso/boot/assets/*.rgb binary
demos/native_iso/Launch-PooleOS-Demo.cmd text eol=lf
